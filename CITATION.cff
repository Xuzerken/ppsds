cff-version: 1.2.0
message: "If you use this software, please cite both the paper and the software itself."
title: "ppsds: distributionally robust probabilistic prediction for stochastic dynamical systems"
abstract: >-
  Reference implementation of DRPP: probabilistic prediction for stochastic dynamical systems
  that is optimal against the worst system permitted by a declared ambiguity set, with
  worst-case guarantees on the expected score.
type: software
license: MIT
repository-code: "https://github.com/Xuzerken/ppsds"
url: "https://github.com/Xuzerken/ppsds"
keywords:
  - distributionally robust optimization
  - probabilistic prediction
  - stochastic dynamical systems
  - conic moment
authors:
  - family-names: Xu
    given-names: Tao
  - family-names: He
    given-names: Jianping
preferred-citation:
