# -- Python bytecode and tool caches --
**/__pycache__*
.pytest_cache/
.ruff_cache/
.mypy_cache/

# -- Virtual environments --
.venv/
venv/

# -- Experiment output: data and figures regenerated by `examples/**` --
# A run's cached pickles are the only copy of that run (see `src/ppsds/experiment/cache.py`),
# so deleting this tree means recomputing thousands of cone programs.
**/data/
**/pic/
*.pkl
*.npy
*.npz
*.pdf
*.png

# -- Build artifacts (python -m build / pip install -e .) --
dist/
build/
*.egg-info/

# -- Documentation build output (mkdocs build) --
site/
